# Database
POSTGRES_USER=cnpuser
POSTGRES_PASSWORD=cnppass  # En local, sert a bootstrapper Vault au premier lancement. En prod, est lu depuis Vault.
POSTGRES_DB=cnp

# Backend
SECRET_KEY=change_this_to_a_secure_random_string_of_at_least_32_characters  # En local, sert a bootstrapper Vault au premier lancement. En prod, est lu depuis Vault.
ENCRYPTION_KEY=  # Clé Fernet dédiée au chiffrement des credentials (distinct du SECRET_KEY JWT). Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURE_COOKIES=false  # Passer à true en production (HTTPS obligatoire)
LOG_LEVEL=INFO
CNP_API_BASE_URL=http://localhost:8000    # URL publique de l'API CNP (doit être accessible depuis les runners GitLab)

# Vault (obligatoire)
# En local : Vault tourne sur un serveur de dev distant partagé. Les variables VAULT_ADDR et VAULT_TOKEN
# sont pré-configurées dans docker-compose.override.yml et n'ont pas besoin d'être définies ici.
# En production : Définir VAULT_ADDR et VAULT_TOKEN pointant vers le Vault de production local.
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=hvs.xxxxxxxxxxxxxxxxxxxx

# Kubernetes
K8S_TARGET_NAMESPACE=default    # Namespace cible pour les déploiements applicatifs
K8S_IMAGE_PULL_SECRET=gitlab-registry    # Nom du secret Docker dans le namespace cible

# Service discovery multi-cluster
CLUSTER_HEALTH_INTERVAL=300
CLUSTER_HEALTH_FAILURE_THRESHOLD=2  # Sondes échouées consécutives avant de marquer un cluster OFFLINE
# Répertoire de kubeconfigs auto-découverts en ClusterConnection (ex: cloud privé k3s cnp-k3s).
# Sert à l'enregistrement (discovery) ; le kubeconfig de routage, lui, est stocké dans Vault (cf. ADR-0018).
KUBECONFIG_DIR=

# Monitoring (Prometheus + Loki)
# En prod (in-cluster) :
#PROMETHEUS_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090
#LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
# En local avec port-forward (le backend est dans Docker, localhost = container, pas le host) :
#   kubectl port-forward -n monitoring svc/prometheus-operated 9090:9090 --address 0.0.0.0 &
#   kubectl port-forward -n monitoring svc/loki 3100:3100 --address 0.0.0.0 & kubectl port-forward -n monitoring svc/grafana 3000:3000 & ./start.sh
PROMETHEUS_URL=http://host.docker.internal:9090
LOKI_URL=http://host.docker.internal:3100
GRAFANA_URL=http://localhost:3000  # En prod HTTPS : https://${GRAFANA_DOMAIN}
GRAFANA_DOMAIN=                   # Domaine DNS pour Grafana HTTPS (ex: grafana.cnp.example.com). Requis avec le profil production.
GRAFANA_DASHBOARD_UID=cnp-group-overview  # UID du dashboard team-metrics (infra/grafana/dashboard.json)
GRAFANA_FINOPS_DASHBOARD_UID=cnp-finops-overview  # UID du dashboard FinOps global (infra/grafana/cnp-finops-overview.json)
GRAFANA_EMBED_TOKEN=              # Token service account Grafana (rôle Viewer). Créer via API, stocker dans Vault.
CERTBOT_EMAIL=                    # Email Let's Encrypt pour les notifications d'expiration de certificat

# GitLab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_BOT_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx  # Group Access Tokens non disponibles sur free-tier
GITLAB_BOT_NAMESPACE=                     # Groupe parent du bot (ex: 4k-cnp-2027)
GITLAB_APPS_NAMESPACE=                    # Subgroup pour les apps scaffoldées (ex: 4k-cnp-2027/cnp-apps). Défaut : {GITLAB_BOT_NAMESPACE}/cnp-apps
GITLAB_TEMPLATES_NAMESPACE=               # Subgroup contenant les repos templates (ex: 4k-cnp-2027/cnp-templates)
GITLAB_CI_PROJECT=                        # Chemin complet du repo CI (ex: 4k-cnp-2027/cnp-ci-modules)
GITLAB_WEBHOOK_SECRET=                    # Secret partagé pour vérifier les webhooks GitLab entrants (X-Gitlab-Token)
GITLAB_TEAMS_GROUP=                       #   ex : 4k-cnp-2027/cnp-apps
# GitOps — Workflow CI/CD (staging = push main, prod = git tag)
GITOPS_REPO_URL=https://gitlab.com/4k-cnp-2027/cnp-gitops.git  # Injecté dans le .gitlab-ci.yml généré
# CNP_BOT_TOKEN : NE PAS METTRE ICI. C'est une variable CI/CD GitLab (masked + protected) à configurer
# au niveau du groupe ou du projet GitLab (Settings > CI/CD > Variables).
# Ce token permet aux pipelines applicatifs de pousser dans cnp-gitops.


# OAuth SSO à créer sur gitlab.com > User Settings > Applications (type: Confidential). Scopes requis : api, read_user
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/gitlab/callback


CLI_REDIRECT_BASE_URL=http://localhost:8765
FRONTEND_BASE_URL=http://localhost
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3001"]
