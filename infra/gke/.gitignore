# State Terraform - contient l'état réel de l'infra, ne pas commiter
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Valeurs propres au projet GCP (partir de terraform.tfvars.example)
terraform.tfvars

# Kubeconfig statique généré par create-cnp-kubeconfig.sh (token admin)
cnp-gke.yaml

# Plan Terraform sauvegardé (peut contenir des valeurs sensibles)
tfplan
