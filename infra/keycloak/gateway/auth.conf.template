server {
    listen 443 ssl;
    server_name ${AUTH_DOMAIN};
    # Login queries contain short-lived codes; do not record them.
    access_log off;
    ssl_certificate /etc/letsencrypt/live/${AUTH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AUTH_DOMAIN}/privkey.pem;
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;
    # NGINX normalizes URL escapes once. Reject a remaining escape to prevent
    # a second decoder upstream from turning it into a protected master path.
    # Same for path parameters: "realms/master;x" does not match the deny-list.
    # Defence in depth: reject ";" here whatever the upstream version does with
    # it (Keycloak 26.8.0 itself answers 400). Query strings are not checked.
    if ($uri ~ "[%;]") { return 403; }
    # $uri stops at a raw "#", but routes proxy the raw $request_uri: "realms/x#/../master"
    # would match no deny rule yet carry a master path upstream. Clients never send a
    # fragment and a "#" in a query string must be encoded, so reject it outright.
    if ($request_uri ~ "#") { return 400; }
    include /etc/nginx/keycloak-routes/*.conf;
    location @keycloak_unavailable { return 503; }
    location / { return 404; }
}
